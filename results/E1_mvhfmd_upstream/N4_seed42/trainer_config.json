{
  "optimizer": "sgd",
  "lr": 0.01,
  "weight_decay": 0.0005,
  "momentum": 0.9,
  "scheduler": "onecycle",
  "div_factor": 10.0,
  "final_div_factor": 1000.0,
  "pct_start_epochs": 5,
  "anneal_strategy": "cos",
  "epochs": 50,
  "batch_size": 40,
  "val_batch_size": 128,
  "grad_clip": 80.0,
  "amp": true,
  "seed": 42,
  "n_views": 4,
  "num_workers": 32,
  "label_smoothing": 0.0,
  "ce_ignore_index": -1,
  "lambda_md": 0.1,
  "md_temp": 4.0,
  "tau_overlap": 4.0,
  "overfit_gap_pp_threshold": 30.0
}